#!/bin/sh

repository_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
runner_script="$repository_root/scripts/local-runner.sh"

if [ ! -x "$runner_script" ]; then
	exit 0
fi

if ! "$runner_script" status >/dev/null 2>&1; then
	printf '\nwarning: the Key Session GitHub Actions runner is offline.\n' >&2
	printf 'start it with: scripts/local-runner.sh start\n\n' >&2
fi

exit 0
